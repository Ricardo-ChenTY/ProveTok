# Dataset/model path presets for server runs.
# Usage:
#   cp scripts/ops/server_paths.env.example scripts/ops/server_paths.env
#   source scripts/ops/server_paths.env

# LLM
export LLM_PATH=/data/models/Meta-Llama-3.1-8B-Instruct

# CT-RATE
export CT_RATE_RAW_MANIFEST=/data/provetok_datasets/ct_rate_100g/manifest.jsonl
export CT_RATE_RRG_ROOT=/data/provetok_datasets/ct_rate_100g_rrg_dpo_all
export CT_RATE_RRG_MANIFEST=/data/provetok_datasets/ct_rate_100g_rrg_dpo_all/manifest_rrg_dpo.jsonl
export CT_RATE_TEST_MANIFEST=/data/provetok_datasets/ct_rate_100g_rrg_dpo_test/manifest_rrg_dpo.jsonl
export CT_RATE_CT2REP_ROOT=/data/provetok_datasets/ct_rate_100g_rrg_dpo_all_ct2rep

# ReXGroundingCT / RadGenome
export REX_MINI_MANIFEST=/data/provetok_datasets/rexgroundingct_mini/manifest.jsonl
export REX_100G_MANIFEST=/data/provetok_datasets/rexgroundingct_100g/manifest.jsonl
export RADGENOME_MANIFEST=/data/provetok_datasets/radgenome_chestct/manifest.jsonl

# Runs
export CT2REP_RUN_DIR=/data/provetok_runs/ct2rep_ct_rate_100g_rrg_dpo_full
export RADEVAL_ENV=/data/conda_envs/radeval311
